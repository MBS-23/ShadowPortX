# ShadowPortX 2.0 backend configuration (copy to .env). All vars are prefixed SPX_.

# --- app ---
SPX_ENVIRONMENT=development           # development | production
SPX_DEBUG=true                        # false in production (disables the dev auth fallback)

# --- security ---
# Generate a strong value in production, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
SPX_SECRET_KEY=change-me-to-a-long-random-secret-in-production
SPX_ACCESS_TOKEN_EXPIRE_MINUTES=720
SPX_ENFORCE_SCOPE=true                # keep true; scanning outside scope is refused

# --- account creation ---
SPX_ALLOW_SELF_REGISTRATION=true      # false = only invited/seeded users can sign in
SPX_SELF_REGISTRATION_ROLE=viewer     # role for self-service signups (least privilege by default)

# --- database ---
# Local default is SQLite (no setup). For Docker/prod use Postgres (asyncpg):
# SPX_DATABASE_URL=postgresql+asyncpg://shadowportx:shadowportx@postgres:5432/shadowportx
# SPX_DATABASE_URL=sqlite+aiosqlite:///./var/shadowportx.db

# --- scanner defaults ---
SPX_SCAN_DEFAULT_PORTS=top1000
SPX_SCAN_MAX_CONCURRENCY=200
SPX_SCAN_RATE_LIMIT_PER_SEC=500
SPX_SCAN_CONNECT_TIMEOUT=1.5

# --- intel ---
SPX_INTEL_OFFLINE_ONLY=true           # true = use bundled CVE seed only (no external calls)
# SPX_NVD_API_KEY=                     # optional: enables live NVD enrichment when offline_only=false

# --- SSO (OpenID Connect) --- works with Google/Okta/Auth0/Azure AD/Keycloak
SPX_OIDC_ENABLED=false
# SPX_OIDC_ISSUER=https://accounts.google.com
# SPX_OIDC_CLIENT_ID=
# SPX_OIDC_CLIENT_SECRET=
# SPX_OIDC_REDIRECT_URI=https://<backend>/api/v1/auth/oidc/callback
# SPX_OIDC_SCOPES=openid email profile
# SPX_OIDC_DEFAULT_ROLE=viewer
# SPX_OIDC_ALLOWED_DOMAIN=            # optional: restrict to one email domain
# SPX_OIDC_POST_LOGIN_REDIRECT=/      # dashboard origin to land on after login
